{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Super admin record verifying super admin permissions",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Auth UID" },
        "email": { "type": "string", "description": "Admin email" },
        "role": { "type": "string", "enum": ["super_admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "role"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role (super_admin or uncle) and class assignments",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Full name of the user/uncle" },
        "role": { "type": "string", "enum": ["super_admin", "uncle"], "description": "Role in system" },
        "phone": { "type": "string", "description": "Phone number" },
        "assignedClassIds": {
          "type": "array",
          "description": "List of class IDs assigned to this uncle",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "displayName", "role"]
    },
    "ClassGroup": {
      "title": "ClassGroup",
      "description": "Class or group of deacons belonging to a stage",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the class" },
        "description": { "type": "string", "description": "Description of class" },
        "stage": { "type": "string", "description": "Educational or church stage" },
        "assignedUncleIds": {
          "type": "array",
          "description": "UIDs of uncles assigned to this class",
          "items": { "type": "string" }
        },
        "assignedUncleNames": {
          "type": "array",
          "description": "Names of uncles assigned to this class",
          "items": { "type": "string" }
        },
        "studentCount": { "type": "integer", "description": "Number of deacons in class" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "stage"]
    },
    "Deacon": {
      "title": "Deacon",
      "description": "Deacon student personal and spiritual data",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "description": "Full name of the deacon" },
        "phone": { "type": "string", "description": "Deacon mobile phone number" },
        "parentPhone": { "type": "string", "description": "Parent mobile phone number" },
        "rank": { "type": "string", "description": "Deacon rank (Epsaltos, Ognostos, etc.)" },
        "classId": { "type": "string", "description": "ID of assigned class" },
        "className": { "type": "string", "description": "Name of assigned class" },
        "grade": { "type": "string", "description": "School or study grade" },
        "birthDate": { "type": "string", "description": "Birth date" },
        "address": { "type": "string", "description": "Home address" },
        "notes": { "type": "string", "description": "Follow-up or spiritual father notes" },
        "addedByUid": { "type": "string", "description": "UID of creator uncle or admin" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "phone", "rank", "classId"]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Super admin records"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles for admins and uncles"
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/ClassGroup" },
      "description": "Classes and groups"
    },
    "/deacons/{deaconId}": {
      "schema": { "$ref": "#/entities/Deacon" },
      "description": "Deacons database"
    }
  }
}
